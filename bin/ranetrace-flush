#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Drain the Ranetrace buffer once. Intended for cron:
 *
 *     * * * * * /path/to/vendor/bin/ranetrace-flush >/dev/null 2>&1
 *
 * A minute is the right cadence: the API allows 60 requests per minute per
 * endpoint for each website, and one run sends at most one batch per type. Configuration
 * comes entirely from the environment, because a cron entry has no application
 * bootstrap to read a config array from; `Ranetrace\Php\Config` resolves every
 * `RANETRACE_*` variable itself.
 *
 * The command never throws and never prints anything on success, so a cron
 * mailer stays quiet unless something is actually wrong. It prints one line on
 * stderr for each of two problems nothing else would tell the operator about,
 * the missing key first. Without `RANETRACE_KEY` it sends nothing: a key the
 * application loads in its own bootstrap does not reach a cron job, and the
 * worker then leaves the spool and the pauses to the process that has the key.
 * A site switched off with `RANETRACE_ENABLED=false` and nothing waiting is
 * left quiet, since nothing is missed there. The buffer is for one user, the
 * one the web server runs as: run as another user, this process can neither
 * drain nor log.
 *
 * Exit codes: 0 drained, or found nothing to drain. 1 could not run, has no
 * key (unless the master switch is off and nothing waits), or this process
 * cannot use the buffer (`FileBuffer::accessProblem()`). In those last two
 * cases the flush still runs first, so a spool this process can partly use
 * gives up what it can.
 */

use Ranetrace\Php\Ranetrace;

(static function (array $argv): never {
    $autoloader = null;

    $candidates = [];

    // Composer's binary proxy sets this, which is the only reliable answer when
    // the package is installed with a relocated vendor directory.
    if (isset($GLOBALS['_composer_autoload_path']) && is_string($GLOBALS['_composer_autoload_path'])) {
        $candidates[] = $GLOBALS['_composer_autoload_path'];
    }

    // Installed as a dependency (vendor/ranetrace/ranetrace-php/bin) and run
    // directly rather than through the proxy.
    $candidates[] = __DIR__.'/../../../autoload.php';

    // Every vendor/autoload.php from here to the filesystem root, which covers
    // the standalone checkout and any nesting in between.
    for ($directory = __DIR__; $directory !== dirname($directory); $directory = dirname($directory)) {
        $candidates[] = $directory.'/vendor/autoload.php';
    }

    foreach ($candidates as $candidate) {
        if (is_file($candidate)) {
            $autoloader = $candidate;

            break;
        }
    }

    if ($autoloader === null) {
        fwrite(STDERR, "ranetrace-flush: could not locate Composer's autoloader.\n");

        exit(1);
    }

    require $autoloader;

    $type = null;

    foreach (array_slice($argv, 1) as $argument) {
        if ($argument === '--help' || $argument === '-h') {
            fwrite(STDOUT, "Usage: ranetrace-flush [--type=errors|events|logs|javascript_errors]\n");

            exit(0);
        }

        if (str_starts_with($argument, '--type=')) {
            $type = substr($argument, 7);

            continue;
        }

        fwrite(STDERR, sprintf("ranetrace-flush: unknown argument [%s].\n", $argument));

        exit(1);
    }

    try {
        // Config layers the RANETRACE_* environment over its defaults, so
        // nothing else has to be passed. The shutdown flush is turned off
        // explicitly: this process exists to flush once, and a second drain on
        // exit would only compete with the next cron run for the buffer lock.
        $ranetrace = new Ranetrace(['flush_on_shutdown' => false]);

        if ($type !== null && ! in_array($type, $ranetrace->buffer()->types(), true)) {
            fwrite(STDERR, sprintf(
                "ranetrace-flush: unknown type [%s]. Expected one of: %s.\n",
                $type,
                implode(', ', $ranetrace->buffer()->types()),
            ));

            exit(1);
        }

        $problem = $ranetrace->buffer()->accessProblem();

        $ranetrace->flush($type);

        $config = $ranetrace->config();
        $keyMissing = false;

        if ($config->key() === '') {
            $waiting = array_filter(
                $ranetrace->buffer()->types(),
                static fn (string $bufferType): bool => $ranetrace->buffer()->count($bufferType) > 0,
            );

            $keyMissing = $config->get('enabled') === true || $waiting !== [];
        }
    } catch (Throwable $failure) {
        fwrite(STDERR, 'ranetrace-flush: '.$failure->getMessage()."\n");

        exit(1);
    }

    if ($keyMissing) {
        fwrite(
            STDERR,
            "ranetrace-flush: RANETRACE_KEY is not set in this command's environment, so nothing is sent. "
            .'This command reads the environment only: a key your application loads from a .env file or sets in its bootstrap does not reach it. '
            ."Set it in the cron job's environment.\n",
        );
    }

    if ($problem !== null) {
        $user = '';

        if (function_exists('posix_geteuid') && function_exists('posix_getpwuid')) {
            $entry = posix_getpwuid(posix_geteuid());
            $user = is_array($entry) && is_string($entry['name'] ?? null) ? sprintf(' as user [%s]', $entry['name']) : '';
        }

        fwrite(STDERR, sprintf(
            "ranetrace-flush: cannot write to the buffer in [%s]%s: %s. Run this command as the user your web server runs as.\n",
            $ranetrace->config()->bufferPath(),
            $user,
            $problem,
        ));

        exit(1);
    }

    exit($keyMissing ? 1 : 0);
})($argv ?? []);
